<% layout("/layouts/boilerplate") %>

<div class="home-page">

    <!-- HERO -->
    <section class="home-hero">
        <div class="hero-overlay"></div>

        <div class="hero-content">
            <p class="hero-label">
                <i class="fa-regular fa-compass"></i>
                Explore. Stay. Wander.
            </p>

            <h1>
                Find your next<br>
                unforgettable stay.
            </h1>

            <p class="hero-subtitle">
                Discover beautiful places, unique stays and destinations
                worth remembering.
            </p>

            <div class="hero-buttons">
                <a href="/listings" class="btn explore-btn">
                    Explore Listings
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

                <a href="/listings/new" class="btn host-btn">
                    <i class="fa-solid fa-plus"></i>
                    Add a Listing
                </a>
            </div>
        </div>
    </section>


    <!-- INTRODUCTION -->
    <section class="home-intro">

        <p class="section-label">DISCOVER WANDERLUST</p>

        <h2>
            Your journey starts with<br>
            the perfect place.
        </h2>

        <p class="intro-text">
            From peaceful mountain cabins to beachfront escapes,
            WanderLust helps you discover stays for every kind of adventure.
        </p>

    </section>


    <!-- FEATURES -->
    <section class="home-features">

        <div class="row g-4">

            <div class="col-md-4">
                <div class="feature-card">

                    <div class="feature-icon">
                        <i class="fa-solid fa-earth-americas"></i>
                    </div>

                    <h4>Explore Places</h4>

                    <p>
                        Browse unique stays and beautiful destinations
                        from around the world.
                    </p>

                </div>
            </div>


            <div class="col-md-4">
                <div class="feature-card">

                    <div class="feature-icon">
                        <i class="fa-regular fa-heart"></i>
                    </div>

                    <h4>Find Your Stay</h4>

                    <p>
                        Discover everything from cozy cottages to
                        luxury villas and mountain retreats.
                    </p>

                </div>
            </div>


            <div class="col-md-4">
                <div class="feature-card">

                    <div class="feature-icon">
                        <i class="fa-solid fa-house"></i>
                    </div>

                    <h4>Share Your Place</h4>

                    <p>
                        Have a place worth discovering? Add your own
                        listing and share it with travelers.
                    </p>

                </div>
            </div>

        </div>

    </section>


    <!-- CTA -->
    <section class="home-cta">

        <div>
            <p class="section-label">READY TO EXPLORE?</p>

            <h2>
                Somewhere new is<br>
                waiting for you.
            </h2>
        </div>

        <a href="/listings" class="btn cta-btn">
            Start Exploring
            <i class="fa-solid fa-arrow-right"></i>
        </a>

    </section>

</div>
