<% layout("layouts/boilerplate") %>
<body>
    <h3>All Listings    </h3>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        <% for( let Listings of allListings ) { %>
            <a href="/listings/<%= Listings._id %>" class="text-link" >
                <div class="listing-card card col" >
                    <img src="<%= Listings.image %>" class="card-img-top" alt="Listing image" style="height: 20rem;">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <b><%= Listings.title %></b>
                            <br>
                            &#8377 <%= Listings.price.toLocaleString("en-IN") %>/night
                        </p>
                    </div>
                </div>
            </a>
        <% } %>
    </div>
</body>